# ============================================================
# Fetch Provenance & Canonical Source URLs (Task — Hermeto-derived)
# ============================================================
# canonicalSourceUrl on PackageIdentity (stable, version-independent)
# fetchedFromUrl on DataSnapshot (observation-scoped, per collection run)
# ============================================================

# Add canonicalSourceUrl to the existing requests PyPI identity (defined above)
ex:requests-pypi-identity pkg:canonicalSourceUrl "https://pypi.org/simple/requests/"^^xsd:anyURI .

# Collection snapshot recording where data was actually fetched
ex:pypi-snapshot-2026-05 a pkg:DataSnapshot ;
    rdfs:label "PyPI snapshot 2026-05-14" ;
    pkg:snapshotTimestamp "2026-05-14T08:00:00Z"^^xsd:dateTime ;
    pkg:snapshotSource "pg-collect pypi" ;
    pkg:fetchedFromUrl "https://pypi-mirror.internal.example.com/simple/"^^xsd:anyURI ;
    pkg:isCurrent true .

# Query: "Which snapshots fetched from a non-canonical mirror?"
# SELECT ?snapshot ?fetchUrl ?source WHERE {
#   ?snapshot a pkg:DataSnapshot ;
#             pkg:fetchedFromUrl ?fetchUrl ;
#             pkg:snapshotSource ?source .
#   FILTER(CONTAINS(STR(?fetchUrl), "mirror"))
# }


# ============================================================
# Repository Operational Lifecycle (Task — Repology-derived)
# ============================================================
# Tracking repository freshness and operational state
# ============================================================

ex:fedora-43-repo a pkg:Repository ;
    rdfs:label "Fedora 43 Everything x86_64" ;
    pkg:repositoryFirstSeen "2025-04-15"^^xsd:date ;
    pkg:repositoryLastFetched "2026-05-14T06:00:00Z"^^xsd:dateTime ;
    pkg:repositoryStatus "active" .

ex:fedora-43-snapshot a pkg:DataSnapshot ;
    rdfs:label "Fedora 43 snapshot 2026-05-14" ;
    pkg:snapshotTimestamp "2026-05-14T06:15:00Z"^^xsd:dateTime ;
    pkg:snapshotSource "pg-collect rpm" ;
    pkg:snapshotGraph "https://packagegraph.github.io/graph/fedora/43"^^xsd:anyURI ;
    pkg:isCurrent true ;
    pkg:snapshotTripleCount "4500000"^^xsd:long .

# Query: "Which repositories haven't been fetched in over 30 days?"
# SELECT ?repo ?lastFetch WHERE {
#   ?repo a pkg:Repository ;
#         pkg:repositoryLastFetched ?lastFetch .
#   FILTER(?lastFetch < "2026-04-14T00:00:00Z"^^xsd:dateTime)
# }
# Note: Replace the literal date with the actual cutoff. Fuseki does not
# support dateTime-duration arithmetic (NOW() - duration) in FILTER.


# ============================================================
# Artifact Variant Selection (Task — Hermeto-derived)
# ============================================================
# Recording which platform-specific binary variant was resolved
# ============================================================

ex:cryptography-wheel a pkg:BinaryPackage ;
    pkg:packageName "cryptography" ;
    pkg:hasVersion ex:cryptography-version ;
    pkg:targetArchitecture ex:arch-x86-64 ;
    pkg:targetOperatingSystem "linux" ;
    pkg:targetABI "cp312" ;
    pkg:targetPlatformTag "manylinux_2_28_x86_64" ;
    rdfs:label "cryptography 42.0.5 (cp312-manylinux_2_28_x86_64)" .

ex:cryptography-version a pkg:Version ;
    pkg:versionString "42.0.5" ;
    rdfs:label "cryptography 42.0.5" .

ex:arch-x86-64 a pkg:Architecture ;
    pkg:architectureName "x86_64" ;
    rdfs:label "x86_64" .

