@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dq: <https://purl.org/packagegraph/ontology/dq#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sec: <https://purl.org/packagegraph/ontology/security#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkg:skos-schemes a owl:Ontology ;
    rdfs:label "PackageGraph SKOS Concept Schemes"@en ;
    dcterms:description "Shared SKOS concept schemes for dependency types, severity levels, advisory categories, checksum algorithms, and related controlled vocabularies used across PackageGraph modules." ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionIRI <https://purl.org/packagegraph/ontology/core/skos-schemes/0.10.0> ;
    owl:versionInfo "0.10.0" .

pkg:algo-md5 a skos:Concept ;
    skos:inScheme pkg:ChecksumAlgorithmScheme ;
    skos:prefLabel "md5" .

pkg:algo-sha1 a skos:Concept ;
    skos:inScheme pkg:ChecksumAlgorithmScheme ;
    skos:prefLabel "sha1" .

pkg:algo-sha256 a skos:Concept ;
    skos:inScheme pkg:ChecksumAlgorithmScheme ;
    skos:prefLabel "sha256" .

pkg:algo-sha512 a skos:Concept ;
    skos:inScheme pkg:ChecksumAlgorithmScheme ;
    skos:prefLabel "sha512" .

pkg:dep-build-requires a skos:Concept ;
    skos:broader pkg:dep-strong ;
    skos:definition "A build-time dependency — needed only during compilation." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "build-requires" .

pkg:dep-check-requires a skos:Concept ;
    skos:broader pkg:dep-weak ;
    skos:definition "A test-time dependency — needed only for running test suites." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "check-requires" .

pkg:dep-enhances a skos:Concept ;
    skos:broader pkg:dep-weak ;
    skos:definition "A reverse-suggests — this package enhances another." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "enhances" .

pkg:dep-recommends a skos:Concept ;
    skos:broader pkg:dep-weak ;
    skos:definition "A recommended dependency — installed by default but can be omitted." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "recommends" .

pkg:dep-requires a skos:Concept ;
    skos:broader pkg:dep-strong ;
    skos:definition "A mandatory runtime dependency — the package cannot function without it." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "requires" .

pkg:dep-suggests a skos:Concept ;
    skos:broader pkg:dep-weak ;
    skos:definition "A suggested dependency — enhances functionality but rarely needed." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "suggests" .

pkg:dep-supplements a skos:Concept ;
    skos:broader pkg:dep-weak ;
    skos:definition "A reverse-recommends — this package supplements another." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:prefLabel "supplements" .

pkg:excl-amd-gpu a skos:Concept ;
    skos:definition "Packages requiring AMD GPU hardware (ROCm compute stack)" ;
    skos:example "rocm-*, amdsmi" ;
    skos:inScheme pkg:ArchExclusionScheme ;
    skos:note "Excluded on: riscv64, ppc64le, s390x" ;
    skos:prefLabel "AMD GPU compute" .

pkg:excl-arch-specific-compiler a skos:Concept ;
    skos:definition "Compiler components that only exist on specific architectures" ;
    skos:example "libquadmath (x86 only — RISC-V uses Q extension)" ;
    skos:inScheme pkg:ArchExclusionScheme ;
    skos:note "Per-package, not pattern-based" ;
    skos:prefLabel "Architecture-specific compiler components" .

pkg:excl-intel-hw a skos:Concept ;
    skos:definition "Packages requiring Intel-specific hardware features (SGX, QAT, oneAPI)" ;
    skos:example "intel-*, sgx-*, qatzip-*, accel-config" ;
    skos:inScheme pkg:ArchExclusionScheme ;
    skos:note "Excluded on: riscv64, aarch64, ppc64le, s390x" ;
    skos:prefLabel "Intel hardware-specific" .

pkg:excl-x86-emulation a skos:Concept ;
    skos:definition "Packages that provide x86/x86_64 binary translation or emulation" ;
    skos:example "wine, wine-*" ;
    skos:inScheme pkg:ArchExclusionScheme ;
    skos:note "Excluded on: riscv64 (no x86 translation layer)" ;
    skos:prefLabel "x86 binary emulation" .

sec:advtype-dsa a skos:Concept ;
    skos:definition "Debian Security Advisory." ;
    skos:inScheme sec:AdvisoryTypeScheme ;
    skos:prefLabel "DSA" .

sec:advtype-glsa a skos:Concept ;
    skos:definition "Gentoo Linux Security Advisory." ;
    skos:inScheme sec:AdvisoryTypeScheme ;
    skos:prefLabel "GLSA" .

sec:advtype-rhsa a skos:Concept ;
    skos:definition "Red Hat Security Advisory." ;
    skos:inScheme sec:AdvisoryTypeScheme ;
    skos:prefLabel "RHSA" .

sec:advtype-usa a skos:Concept ;
    skos:definition "Ubuntu Security Advisory." ;
    skos:inScheme sec:AdvisoryTypeScheme ;
    skos:prefLabel "USA" .

sec:sev-critical a skos:Concept ;
    skos:definition "CVSS 9.0-10.0. Immediate exploitation risk, full system compromise." ;
    skos:inScheme sec:SeverityScheme ;
    skos:notation 4 ;
    skos:prefLabel "critical" .

sec:sev-important a skos:Concept ;
    skos:altLabel "high" ;
    skos:definition "CVSS 7.0-8.9. Significant exploitation risk." ;
    skos:inScheme sec:SeverityScheme ;
    skos:notation 3 ;
    skos:prefLabel "important" .

sec:sev-low a skos:Concept ;
    skos:definition "CVSS 0.1-3.9. Minimal exploitation risk." ;
    skos:inScheme sec:SeverityScheme ;
    skos:notation 1 ;
    skos:prefLabel "low" .

sec:sev-moderate a skos:Concept ;
    skos:altLabel "medium" ;
    skos:definition "CVSS 4.0-6.9. Limited exploitation risk." ;
    skos:inScheme sec:SeverityScheme ;
    skos:notation 2 ;
    skos:prefLabel "moderate" .

sec:sev-none a skos:Concept ;
    skos:definition "No known severity or not applicable." ;
    skos:inScheme sec:SeverityScheme ;
    skos:notation 0 ;
    skos:prefLabel "none" .

sec:cat-bugfix a skos:Concept ;
    skos:definition "Advisory addressing a non-security software defect." ;
    skos:inScheme sec:AdvisoryCategoryScheme ;
    skos:prefLabel "bugfix" .

sec:cat-enhancement a skos:Concept ;
    skos:definition "Advisory introducing new functionality or improvement." ;
    skos:inScheme sec:AdvisoryCategoryScheme ;
    skos:prefLabel "enhancement" .

sec:cat-security a skos:Concept ;
    skos:definition "Advisory addressing a security vulnerability." ;
    skos:inScheme sec:AdvisoryCategoryScheme ;
    skos:prefLabel "security" .

sec:event-fixed a skos:Concept ;
    skos:definition "The version in which the vulnerability was fixed." ;
    skos:inScheme sec:EventTypeScheme ;
    skos:prefLabel "fixed" .

sec:event-introduced a skos:Concept ;
    skos:definition "The version in which the vulnerability was introduced." ;
    skos:inScheme sec:EventTypeScheme ;
    skos:prefLabel "introduced" .

sec:event-last-affected a skos:Concept ;
    skos:definition "The last known version affected by the vulnerability." ;
    skos:inScheme sec:EventTypeScheme ;
    skos:prefLabel "last_affected" .

sec:range-ecosystem a skos:Concept ;
    skos:definition "Ecosystem-specific versioning scheme (e.g., deb, rpm version comparison)." ;
    skos:inScheme sec:RangeTypeScheme ;
    skos:prefLabel "ECOSYSTEM" .

sec:range-git a skos:Concept ;
    skos:definition "Git commit hash-based version range." ;
    skos:inScheme sec:RangeTypeScheme ;
    skos:prefLabel "GIT" .

sec:range-semver a skos:Concept ;
    skos:definition "Semantic versioning scheme (MAJOR.MINOR.PATCH)." ;
    skos:inScheme sec:RangeTypeScheme ;
    skos:prefLabel "SEMVER" .

pkg:dep-strong a skos:Concept ;
    skos:definition "Dependencies that are mandatory for package function." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:narrower pkg:dep-build-requires,
        pkg:dep-requires ;
    skos:prefLabel "strong dependency" .

pkg:ArchExclusionScheme a skos:ConceptScheme ;
    rdfs:label "Architecture-Specific Package Exclusions"@en ;
    dcterms:description "Packages or package patterns that are known to be unavailable on certain architectures due to hardware or architectural constraints, not build failures" ;
    skos:hasTopConcept pkg:excl-amd-gpu,
        pkg:excl-arch-specific-compiler,
        pkg:excl-intel-hw,
        pkg:excl-x86-emulation .

pkg:ChecksumAlgorithmScheme a skos:ConceptScheme ;
    rdfs:label "Checksum Algorithms"@en ;
    dcterms:description "Cryptographic hash algorithms used for package integrity verification" ;
    skos:hasTopConcept pkg:algo-md5,
        pkg:algo-sha1,
        pkg:algo-sha256,
        pkg:algo-sha512 .

sec:AdvisoryTypeScheme a skos:ConceptScheme ;
    rdfs:label "Security Advisory Types"@en ;
    dcterms:description "Classification of vendor security advisory formats" ;
    skos:hasTopConcept sec:advtype-dsa,
        sec:advtype-glsa,
        sec:advtype-rhsa,
        sec:advtype-usa .

sec:AdvisoryCategoryScheme a skos:ConceptScheme ;
    rdfs:label "Advisory Category"@en ;
    dcterms:description "Classification of advisory purpose: security fix, bugfix, or enhancement. Distinct from AdvisoryTypeScheme which classifies vendor advisory formats (DSA, RHSA)." ;
    skos:hasTopConcept sec:cat-bugfix,
        sec:cat-enhancement,
        sec:cat-security .

sec:EventTypeScheme a skos:ConceptScheme ;
    rdfs:label "Vulnerability Event Types"@en ;
    dcterms:description "OSV-aligned event types marking when a vulnerability was introduced, fixed, or last affected" ;
    skos:hasTopConcept sec:event-fixed,
        sec:event-introduced,
        sec:event-last-affected .

sec:RangeTypeScheme a skos:ConceptScheme ;
    rdfs:label "Affected Range Versioning Schemes"@en ;
    dcterms:description "OSV-aligned versioning scheme types for affected version ranges" ;
    skos:hasTopConcept sec:range-ecosystem,
        sec:range-git,
        sec:range-semver .

sec:SeverityScheme a skos:ConceptScheme ;
    rdfs:label "Vulnerability Severity Levels"@en ;
    dcterms:description "CVSS-aligned severity classification for security vulnerabilities" ;
    skos:hasTopConcept sec:sev-critical,
        sec:sev-important,
        sec:sev-low,
        sec:sev-moderate,
        sec:sev-none .

pkg:dep-weak a skos:Concept ;
    skos:definition "Dependencies that are optional or enhancing." ;
    skos:inScheme pkg:DependencyTypeScheme ;
    skos:narrower pkg:dep-check-requires,
        pkg:dep-enhances,
        pkg:dep-recommends,
        pkg:dep-suggests,
        pkg:dep-supplements ;
    skos:prefLabel "weak dependency" .

pkg:DependencyTypeScheme a skos:ConceptScheme ;
    rdfs:label "Package Dependency Types"@en ;
    dcterms:description "Classification of dependency relationships between packages" ;
    skos:hasTopConcept pkg:dep-strong,
        pkg:dep-weak .

pkg:fresh-newest a skos:Concept ;
    skos:definition "The version in this repository is the newest known version across all tracked repositories." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "newest" .

pkg:fresh-outdated a skos:Concept ;
    skos:definition "A newer version exists in at least one other tracked repository." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "outdated" .

pkg:fresh-legacy a skos:Concept ;
    skos:definition "An older version maintained in parallel with a newer branch (e.g., Python 2 alongside Python 3)." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "legacy" .

pkg:fresh-devel a skos:Concept ;
    skos:definition "A pre-release or development version (alpha, beta, rc, git snapshot)." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "devel" .

pkg:fresh-rolling a skos:Concept ;
    skos:definition "Version from a rolling-release repository where traditional version comparison is not meaningful." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "rolling" .

pkg:fresh-unique a skos:Concept ;
    skos:definition "The package exists in only one repository family, so freshness comparison is not possible." ;
    skos:inScheme pkg:FreshnessStatusScheme ;
    skos:prefLabel "unique" .

pkg:FreshnessStatusScheme a skos:ConceptScheme ;
    rdfs:label "Version Freshness Status"@en ;
    dcterms:description "Classification of package version currency relative to other repositories — derived from Repology's version classification system" ;
    skos:hasTopConcept pkg:fresh-newest,
        pkg:fresh-outdated,
        pkg:fresh-legacy,
        pkg:fresh-devel,
        pkg:fresh-rolling,
        pkg:fresh-unique .

pkg:link-homepage a skos:Concept ;
    skos:definition "The upstream project's primary website or landing page." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "homepage" .

pkg:link-download a skos:Concept ;
    skos:definition "Direct download URL for the package archive or binary." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "download" .

pkg:link-issues a skos:Concept ;
    skos:definition "Bug tracker or issue tracker URL." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "issues" .

pkg:link-changelog a skos:Concept ;
    skos:definition "Changelog or release notes URL." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "changelog" .

pkg:link-documentation a skos:Concept ;
    skos:definition "Documentation or API reference URL." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "documentation" .

pkg:link-build-log a skos:Concept ;
    skos:definition "Build log or CI pipeline URL for a specific package build." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "build-log" .

pkg:link-recipe a skos:Concept ;
    skos:definition "Package recipe or build specification (spec file, PKGBUILD, Debian rules)." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "recipe" .

pkg:link-registry a skos:Concept ;
    skos:definition "Package registry page (PyPI, npm, crates.io, etc.)." ;
    skos:inScheme pkg:LinkTypeScheme ;
    skos:prefLabel "registry" .

pkg:LinkTypeScheme a skos:ConceptScheme ;
    rdfs:label "Package Link Types"@en ;
    dcterms:description "Classification of URLs associated with packages — derived from Repology's 28+ link type taxonomy, reduced to broadly applicable categories" ;
    skos:hasTopConcept pkg:link-homepage,
        pkg:link-download,
        pkg:link-issues,
        pkg:link-changelog,
        pkg:link-documentation,
        pkg:link-build-log,
        pkg:link-recipe,
        pkg:link-registry .

pkg:match-upstream-verified a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "upstream verified"@en ;
    skos:definition "Identity confirmed via upstream project metadata (e.g., PyPI project URL matches RPM Source URL)."@en .

pkg:match-repository-shared a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "repository shared"@en ;
    skos:definition "Both packages link to the same upstream VCS repository."@en .

pkg:match-name-heuristic a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "name heuristic"@en ;
    skos:definition "Identity inferred from package name similarity after normalization (e.g., python3-requests ↔ requests)."@en .

pkg:match-fork-detected a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "fork detected"@en ;
    skos:definition "Repository fork relationship detected between upstream sources."@en .

pkg:match-repackage-detected a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "repackage detected"@en ;
    skos:definition "Package appears to be a repackaging of another package under a different name."@en .

pkg:match-repology a skos:Concept ;
    skos:inScheme pkg:MatchMethodScheme ;
    skos:prefLabel "Repology equivalence"@en ;
    skos:definition "Cross-distribution equivalence asserted by Repology project mapping."@en .

pkg:MatchMethodScheme a skos:ConceptScheme ;
    rdfs:label "Match Method Scheme"@en ;
    dcterms:description "Methods used to establish cross-ecosystem package identity relationships — from verified upstream metadata to heuristic name matching" ;
    skos:hasTopConcept pkg:match-upstream-verified,
        pkg:match-repository-shared,
        pkg:match-name-heuristic,
        pkg:match-fork-detected,
        pkg:match-repackage-detected,
        pkg:match-repology .

dq:cat-dead-homepage a skos:Concept ;
    skos:definition "The package's homepage URL returns a permanent error (4xx/5xx) or is unreachable." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "dead-homepage" .

dq:cat-dead-download a skos:Concept ;
    skos:definition "The package's download URL is unreachable or returns an error." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "dead-download" .

dq:cat-dead-repo a skos:Concept ;
    skos:definition "The upstream source code repository is unreachable, archived, or deleted." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "dead-repo" .

dq:cat-missing-cpe a skos:Concept ;
    skos:definition "The package has no CPE identifier, preventing CVE correlation." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "missing-cpe" .

dq:cat-missing-license a skos:Concept ;
    skos:definition "The package has no license metadata." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "missing-license" .

dq:cat-malformed-email a skos:Concept ;
    skos:definition "A maintainer or contributor email address does not conform to RFC 5322." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "malformed-email" .

dq:cat-missing-checksum a skos:Concept ;
    skos:definition "The package artifact has no checksum in its lockfile or metadata — a supply chain risk signal." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "missing-checksum" .

dq:cat-missing-upstream a skos:Concept ;
    skos:definition "The package has no upstream project or repository link, preventing cross-distribution analysis." ;
    skos:inScheme dq:IssueCategoryScheme ;
    skos:prefLabel "missing-upstream" .

dq:IssueCategoryScheme a skos:ConceptScheme ;
    rdfs:label "Data Quality Issue Categories"@en ;
    dcterms:description "Structured taxonomy of well-known data quality problems in package metadata — derived from Repology's problem detection and Hermeto's missing-hash tracking" ;
    skos:hasTopConcept dq:cat-dead-homepage,
        dq:cat-dead-download,
        dq:cat-dead-repo,
        dq:cat-missing-cpe,
        dq:cat-missing-license,
        dq:cat-malformed-email,
        dq:cat-missing-checksum,
        dq:cat-missing-upstream .
