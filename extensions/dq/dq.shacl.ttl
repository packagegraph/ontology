@prefix dq: <https://purl.org/packagegraph/ontology/dq#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dq:DataQualityIssueShape a sh:NodeShape ;
    sh:property [ sh:message "A data quality issue must have at least one label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:in ( dq:cat-dead-homepage dq:cat-dead-download dq:cat-dead-repo dq:cat-missing-cpe dq:cat-missing-license dq:cat-malformed-email dq:cat-missing-checksum dq:cat-missing-upstream ) ;
            sh:maxCount 1 ;
            sh:message "Issue category must be a concept from IssueCategoryScheme."@en ;
            sh:path dq:issueCategory ;
            sh:severity sh:Info ] ;
    sh:targetClass dq:DataQualityIssue .

