@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <https://purl.org/packagegraph/ontology/taxonomy#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tax: a owl:Ontology ;
    rdfs:label "OSS Software Taxonomy"@en ;
    dcterms:abstract "A SKOS concept scheme for classifying open source software using the ecosyste.ms OSS Taxonomy — 6 facets (domain, role, function, audience, layer, technology). Ships with 15 representative stub concepts; the full set of 173 terms can be generated by scripts/import-oss-taxonomy.py from the CC0-licensed ecosyste.ms/oss-taxonomy combined-taxonomy.json." ;
    dcterms:created "2026-06-04"^^xsd:date ;
    dcterms:creator <https://packagegraph.github.io/> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:source <https://github.com/ecosyste-ms/oss-taxonomy> ;
    dcterms:title "OSS Software Taxonomy"@en ;
    owl:imports pkg: ;
    owl:versionIRI <https://purl.org/packagegraph/ontology/taxonomy/0.13.0> ;
    owl:versionInfo "0.13.0" .

tax:TaxonomyScheme a skos:ConceptScheme ;
    rdfs:label "OSS Taxonomy"@en ;
    skos:prefLabel "OSS Software Taxonomy"@en ;
    skos:definition "Multi-faceted classification system for open source software projects, derived from ecosyste.ms/oss-taxonomy."@en .

tax:DomainFacet a skos:Collection ;
    rdfs:label "Domain Facet"@en ;
    skos:prefLabel "Domain"@en ;
    skos:definition "The industry or field the software is designed for."@en .

tax:RoleFacet a skos:Collection ;
    rdfs:label "Role Facet"@en ;
    skos:prefLabel "Role"@en ;
    skos:definition "The function or responsibility the software has in a system or workflow."@en .

tax:FunctionFacet a skos:Collection ;
    rdfs:label "Function Facet"@en ;
    skos:prefLabel "Function"@en ;
    skos:definition "What the software does — its primary capabilities or use cases."@en .

tax:AudienceFacet a skos:Collection ;
    rdfs:label "Audience Facet"@en ;
    skos:prefLabel "Audience"@en ;
    skos:definition "Who the software is for — the primary users or target audience."@en .

tax:LayerFacet a skos:Collection ;
    rdfs:label "Layer Facet"@en ;
    skos:prefLabel "Layer"@en ;
    skos:definition "Where in the software stack the project sits or operates."@en .

tax:TechnologyFacet a skos:Collection ;
    rdfs:label "Technology Facet"@en ;
    skos:prefLabel "Technology"@en ;
    skos:definition "Specific technologies, languages, or frameworks used or supported."@en .

# Representative stub concepts used by examples and CQs.
# The full set of 173 terms is generated by scripts/import-oss-taxonomy.py
# from ecosyste.ms/oss-taxonomy combined-taxonomy.json and should be merged
# into this file or loaded alongside it.

tax:domain-security a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Security"@en ;
    skos:definition "Software focused on security, cryptography, or access control."@en .

tax:domain-web-development a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Web Development"@en ;
    skos:definition "Software for building web applications and services."@en .

tax:domain-operating-systems a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Operating Systems"@en ;
    skos:definition "Software for operating system components and system management."@en .

tax:role-library a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Library"@en ;
    skos:definition "A reusable code library consumed by other software."@en .

tax:role-framework a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Framework"@en ;
    skos:definition "An application framework providing structure and conventions."@en .

tax:role-service a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Service"@en ;
    skos:definition "A long-running service or daemon."@en .

tax:function-encryption a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Encryption"@en ;
    skos:definition "Provides cryptographic encryption and decryption capabilities."@en .

tax:function-api-development a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "API Development"@en ;
    skos:definition "Tools and frameworks for building APIs."@en .

tax:function-authentication a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Authentication"@en ;
    skos:definition "User authentication and identity verification."@en .

tax:function-process-management a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Process Management"@en ;
    skos:definition "Process lifecycle management, init systems, and service supervision."@en .

tax:audience-developer a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Developer"@en ;
    skos:definition "Software developers and programmers."@en .

tax:audience-enterprise a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Enterprise"@en ;
    skos:definition "Enterprise and organizational users."@en .

tax:audience-system-administrator a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "System Administrator"@en ;
    skos:definition "System administrators and operations engineers."@en .

tax:layer-infrastructure a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Infrastructure"@en ;
    skos:definition "Infrastructure-level software (OS, networking, storage)."@en .

tax:layer-backend a skos:Concept ;
    skos:inScheme tax:TaxonomyScheme ;
    skos:prefLabel "Backend"@en ;
    skos:definition "Server-side application logic and services."@en .

tax:DomainFacet skos:member tax:domain-security ,
    tax:domain-web-development ,
    tax:domain-operating-systems .

tax:RoleFacet skos:member tax:role-library ,
    tax:role-framework ,
    tax:role-service .

tax:FunctionFacet skos:member tax:function-encryption ,
    tax:function-api-development ,
    tax:function-authentication ,
    tax:function-process-management .

tax:AudienceFacet skos:member tax:audience-developer ,
    tax:audience-enterprise ,
    tax:audience-system-administrator .

tax:LayerFacet skos:member tax:layer-infrastructure ,
    tax:layer-backend .
