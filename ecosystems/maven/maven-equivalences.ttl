@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# ============================================================
# Maven Cross-Coordinate Equivalences
# ============================================================
#
# Each pair asserts that two Maven PackageIdentity instances represent
# the same upstream codebase under different coordinates.
# pkg:upstreamEquivalent is symmetric — only one direction needed.
#
# Curation policy:
# - Only same-codebase coordinate changes (renames, namespace migrations)
# - NOT forks with divergent code (e.g., MariaDB vs MySQL)
# - NOT version-level equivalence (javax 4.x ≠ jakarta 5.x APIs)
#
# Load into Fuseki as: <https://packagegraph.github.io/graph/maven/equivalences>
# ============================================================

<https://purl.org/packagegraph/ontology/maven/equivalences> a owl:Ontology ;
    rdfs:label "PackageGraph Maven Equivalence Seed"@en ;
    dcterms:description "A curated seed dataset of high-confidence upstream-equivalent Maven coordinates, including Jakarta EE namespace migrations and selected artifact renames." ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionIRI <https://purl.org/packagegraph/ontology/maven/equivalences/0.11.0> ;
    owl:versionInfo "0.11.0" .

# --- javax → Jakarta EE 9+ API migrations ---
# Jakarta EE 9 moved all javax.* APIs to jakarta.* namespace.
# Same codebase, same vulnerability surface, different coordinates.

<https://packagegraph.github.io/d/pkg/maven/javax.servlet/javax.servlet-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.servlet/jakarta.servlet-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.persistence/javax.persistence-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.persistence/jakarta.persistence-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.mail/javax.mail-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.mail/jakarta.mail-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.ws.rs/javax.ws.rs-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.ws.rs/jakarta.ws.rs-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.inject/javax.inject>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.inject/jakarta.inject-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.annotation/javax.annotation-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.annotation/jakarta.annotation-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.validation/validation-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.validation/jakarta.validation-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.el/javax.el-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.el/jakarta.el-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.json/javax.json-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.json/jakarta.json-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.websocket/javax.websocket-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.websocket/jakarta.websocket-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.enterprise/cdi-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.enterprise/jakarta.enterprise.cdi-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.faces/javax.faces-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.faces/jakarta.faces-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.transaction/javax.transaction-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.transaction/jakarta.transaction-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.security.enterprise/javax.security.enterprise-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.security.enterprise/jakarta.security.enterprise-api> .

<https://packagegraph.github.io/d/pkg/maven/javax.batch/javax.batch-api>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/jakarta.batch/jakarta.batch-api> .

# --- High-profile coordinate renames ---

<https://packagegraph.github.io/d/pkg/maven/mysql/mysql-connector-java>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/com.mysql/mysql-connector-j> .

<https://packagegraph.github.io/d/pkg/maven/commons-io/commons-io>
    pkg:upstreamEquivalent <https://packagegraph.github.io/d/pkg/maven/org.apache.commons/commons-io> .

# NOTE: commons-lang → commons-lang3 intentionally omitted.
# commons-lang3 is an API-breaking rewrite, not a coordinate rename.
# Different codebase = different vulnerability surface.
