@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix cargo: <https://purl.org/packagegraph/ontology/cargo#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# CARGO Example — serde 1.0.210
# ============================================================

ex:cargo-serde-identity
    a pkg:PackageIdentity ;
    pkg:identityName "serde" .

ex:cargo-serde-1-0-210
    a pkg:Package, pkg:SourcePackage, cargo:Crate ;
    pkg:packageName "serde" ;
    pkg:isVersionOf ex:cargo-serde-identity ;
    pkg:hasVersion ex:cargo-serde-ver-1-0-210 ;
    cargo:edition "2021" ;
    cargo:msrv "1.31" .

ex:cargo-serde-ver-1-0-210
    a pkg:Version ;
    pkg:versionString "1.0.210" .
