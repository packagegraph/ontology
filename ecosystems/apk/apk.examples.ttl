@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix apk: <https://purl.org/packagegraph/ontology/apk#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# APK Example — musl 1.2.5-r0
# ============================================================

ex:apk-musl-identity
    a pkg:PackageIdentity ;
    pkg:identityName "musl" .

ex:apk-musl-1-2-5-r0
    a pkg:Package, pkg:BinaryPackage, apk:ApkPackage ;
    pkg:packageName "musl" ;
    pkg:isVersionOf ex:apk-musl-identity ;
    pkg:hasVersion ex:apk-musl-ver-1-2-5-r0 ;
    apk:apkOrigin "musl" ;
    apk:apkChecksum "Q1abc123def456" .

ex:apk-musl-ver-1-2-5-r0
    a pkg:Version ;
    pkg:versionString "1.2.5-r0" .
