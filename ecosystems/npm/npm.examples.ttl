@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix npm: <https://purl.org/packagegraph/ontology/npm#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# NPM Example — lodash 4.17.21
# ============================================================

ex:npm-lodash-identity
    a pkg:PackageIdentity ;
    pkg:identityName "lodash" .

ex:npm-lodash-4-17-21
    a pkg:Package, pkg:SourcePackage, npm:NpmPackage ;
    pkg:packageName "lodash" ;
    pkg:isVersionOf ex:npm-lodash-identity ;
    pkg:hasVersion ex:npm-lodash-ver-4-17-21 ;
    npm:engines ">=0.10.0" ;
    npm:fileCount 1054 .

ex:npm-lodash-ver-4-17-21
    a pkg:Version ;
    pkg:versionString "4.17.21" .
