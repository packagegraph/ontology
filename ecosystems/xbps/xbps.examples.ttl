@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix xbps: <https://purl.org/packagegraph/ontology/xbps#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# XBPS Example — openssl 3.3.2_1
# ============================================================

ex:xbps-openssl-identity
    a pkg:PackageIdentity ;
    pkg:identityName "openssl" .

ex:xbps-openssl-3-3-2-1
    a pkg:Package, pkg:BinaryPackage, xbps:XbpsPackage ;
    pkg:packageName "openssl" ;
    pkg:isVersionOf ex:xbps-openssl-identity ;
    pkg:hasVersion ex:xbps-openssl-ver-3-3-2-1 ;
    xbps:shortDesc "Toolkit for Secure Sockets Layer and general purpose cryptography" ;
    xbps:xbpsRevision 1 .

ex:xbps-openssl-ver-3-3-2-1
    a pkg:Version ;
    pkg:versionString "3.3.2_1" .
