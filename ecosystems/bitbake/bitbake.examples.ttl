@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix bitbake: <https://purl.org/packagegraph/ontology/bitbake#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# BITBAKE Example — busybox 1.36.1
# ============================================================

ex:bitbake-busybox-identity
    a pkg:PackageIdentity ;
    pkg:identityName "busybox" .

ex:bitbake-busybox-1-36-1
    a pkg:Package, pkg:SourcePackage, bitbake:BitBakeRecipe ;
    pkg:packageName "busybox" ;
    pkg:isVersionOf ex:bitbake-busybox-identity ;
    pkg:hasVersion ex:bitbake-busybox-ver-1-36-1 ;
    bitbake:layer "poky/meta" ;
    bitbake:section "base" ;
    bitbake:pv "1.36.1" .

ex:bitbake-busybox-ver-1-36-1
    a pkg:Version ;
    pkg:versionString "1.36.1" .
