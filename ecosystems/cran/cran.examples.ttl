@prefix ex: <https://purl.org/packagegraph/ontology/examples#> .
@prefix cran: <https://purl.org/packagegraph/ontology/cran#> .
@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# CRAN Example — ggplot2 3.5.1
# ============================================================

ex:cran-ggplot2-identity
    a pkg:PackageIdentity ;
    pkg:identityName "ggplot2" .

ex:cran-ggplot2-3-5-1
    a pkg:Package, pkg:SourcePackage, cran:CranPackage ;
    pkg:packageName "ggplot2" ;
    pkg:isVersionOf ex:cran-ggplot2-identity ;
    pkg:hasVersion ex:cran-ggplot2-ver-3-5-1 ;
    cran:title "Create Elegant Data Visualisations Using the Grammar of Graphics" ;
    cran:needsCompilation false .

ex:cran-ggplot2-ver-3-5-1
    a pkg:Version ;
    pkg:versionString "3.5.1" .
