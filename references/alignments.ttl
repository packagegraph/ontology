@prefix pkg: <https://purl.org/packagegraph/ontology/core#> .
@prefix sec: <https://purl.org/packagegraph/ontology/security#> .
@prefix vcs: <https://purl.org/packagegraph/ontology/vcs#> .
@prefix slsa: <https://purl.org/packagegraph/ontology/slsa#> .
@prefix met: <https://purl.org/packagegraph/ontology/metrics#> .

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://purl.org/packagegraph/ontology/alignments> a owl:Ontology ;
    rdfs:isDefinedBy <https://purl.org/packagegraph/ontology/alignments> ;
    rdfs:label "PackageGraph External Alignments" ;
    rdfs:comment "Formal alignment declarations between PackageGraph ontology and external standards (PROV-O, SPDX, Schema.org)" ;
    dcterms:created "2026-04-18"^^xsd:date ;
    dcterms:creator <https://packagegraph.github.io/> ;
    dcterms:description "Directional mappings from PackageGraph to PROV-O and Schema.org, with legacy SPDX RDF-term mappings. This module does not assert complete SPDX 3 conformance." ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-09-23"^^xsd:date ;

    owl:priorVersion <https://purl.org/packagegraph/ontology/alignments/0.12.0> ;

    owl:versionIRI <https://purl.org/packagegraph/ontology/alignments/0.14.0> ;

    owl:versionInfo "0.14.0" .

# =============================================================================
# PROV-O Alignment
# =============================================================================
# PackageGraph predicates specialize the external relations. The reverse
# inference is not justified: arbitrary derivation is not compilation, and
# arbitrary activity association is not PackageGraph packaging participation.

pkg:builtFromSource rdfs:subPropertyOf prov:wasDerivedFrom .
pkg:performedBy rdfs:subPropertyOf prov:wasAssociatedWith .
pkg:BuildActivity rdfs:subClassOf prov:Activity .
pkg:DataSnapshot rdfs:subClassOf prov:Entity .
pkg:PackagingActivity rdfs:subClassOf prov:Activity .
pkg:PublishingActivity rdfs:subClassOf prov:Activity .
pkg:InstallationActivity rdfs:subClassOf prov:Activity .

# =============================================================================
# SPDX Alignment
# =============================================================================
# Enables SPARQL CONSTRUCT generation of SPDX SBOM documents.
# PackageGraph License entities use SPDX license IRIs directly.

pkg:License owl:equivalentClass spdx:License .
pkg:hasChecksum owl:equivalentProperty spdx:checksum .
pkg:Package rdfs:subClassOf spdx:Package .
pkg:downloadURL owl:equivalentProperty spdx:downloadLocation .

# =============================================================================
# Schema.org Alignment
# =============================================================================
# Enables search engine discovery and knowledge graph integration.
# Export local metadata without importing arbitrary external subjects into
# PackageGraph's narrower domains or functional-property restrictions.

pkg:description rdfs:subPropertyOf schema:description .
pkg:homepage rdfs:subPropertyOf schema:url .
pkg:Person rdfs:subClassOf schema:Person .
pkg:Package rdfs:seeAlso schema:SoftwareApplication .
# Not subClassOf because Package includes source packages, meta packages, and
# phantom packages that are not applications in Schema.org terms.
pkg:packageName rdfs:subPropertyOf schema:name .
pkg:versionString rdfs:subPropertyOf schema:version .

# =============================================================================
# VCS ↔ PROV-O (reinforcing declarations already in vcs.ttl)
# =============================================================================

vcs:Commit rdfs:subClassOf prov:Entity .
vcs:PullRequest rdfs:subClassOf prov:Activity .
vcs:Branch rdfs:subClassOf prov:Entity .
vcs:Tag rdfs:subClassOf prov:Entity .

# =============================================================================
# SLSA ↔ PROV-O (reinforcing declarations already in slsa.ttl)
# =============================================================================

slsa:ProvenanceAttestation rdfs:subClassOf prov:Entity .
slsa:Builder rdfs:subClassOf prov:Agent .
slsa:SourceAttestation rdfs:subClassOf prov:Entity .
slsa:BuildEnvironment rdfs:subClassOf prov:Entity .
